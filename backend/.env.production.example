PORT=3001

# Firebase (Firestore + Auth) do projeto de PRODUÇÃO — service account gerada
# em Firebase Console > Configurações do projeto > Contas de serviço >
# Gerar nova chave privada, no projeto de produção (não o de dev).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# URL(s) real(is) do frontend publicado, separadas por vírgula.
# ALLOWED_ORIGINS=https://kronoop-a1b2c.web.app,https://seuusuario.github.io
ALLOWED_ORIGINS=

# Uso local (rodar scripts contra produção sem mexer no .env do dia a dia):
#   copy .env.production.example .env.production   (preencha os valores acima)
#   $env:ENV_FILE=".env.production"; node scripts/seed-firestore.js
#
# Em produção de verdade (Cloud Run/Render), estas variáveis vão direto na
# configuração do serviço (--env-vars-file backend/.env.yaml no Cloud Run,
# ou "Environment" no painel do Render) — este arquivo é só um guia/backup
# local, não é o que o servidor publicado lê.
