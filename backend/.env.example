PORT=3001

# Firebase (Firestore + Auth) — service account gerada em
# Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Origens (CORS) autorizadas a chamar esta API, separadas por vírgula.
# Deixe em branco para o padrão de desenvolvimento (file:// e localhost:5500).
# Em produção, use a(s) URL(s) real(is) do frontend publicado, ex.:
# ALLOWED_ORIGINS=https://kronoop-a1b2c.web.app,https://seuusuario.github.io
ALLOWED_ORIGINS=
