PORT=3001

# Firebase (Firestore + Auth) — service account gerada em
# Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Supabase (Postgres + Auth) — só preencher no dia da migração (ver
# docs/MIGRACAO-SUPABASE.md). SUPABASE_SERVICE_ROLE_KEY fica em
# Project Settings > API > service_role — nunca a anon key aqui, essa é
# só para o frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Origens (CORS) autorizadas a chamar esta API, separadas por vírgula.
# Deixe em branco para o padrão de desenvolvimento (file:// e localhost:5500).
# Em produção, use a(s) URL(s) real(is) do frontend publicado, ex.:
# ALLOWED_ORIGINS=https://kronoop-a1b2c.web.app,https://seuusuario.github.io
ALLOWED_ORIGINS=

# Token compartilhado com o Apps Script da planilha de roteirização (ver
# backend/src/controllers/planilhaImport.controller.js) — mesmo valor
# configurado lá em PropertiesService (KRONOS_TOKEN). Endpoint fora do
# login normal do Kronos, se autentica só com esse token.
PLANILHA_IMPORT_TOKEN=
